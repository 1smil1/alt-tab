<Window x:Class="WindowSwitcherWpf.SwitcherOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:WindowSwitcherWpf.Controls"
        Title="Window Switcher"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F7"
        SizeToContent="WidthAndHeight"
        MaxHeight="760"
        MaxWidth="1400">
    <Border BorderBrush="#22000000"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="2" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Vertical">
            <ItemsControl x:Name="WindowsList" ItemsSource="{Binding AllWindows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" MaxWidth="1320" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card"
                                Margin="6"
                                Width="240"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnCardClick">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="6,4,6,6">
                                    <Image Width="20" Height="20"
                                           VerticalAlignment="Center"
                                           Source="{Binding Icon}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="#202020"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"
                                               MaxWidth="190"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border CornerRadius="6"
                                        Background="White"
                                        BorderBrush="#22000000"
                                        BorderThickness="1"
                                        Height="150"
                                        Margin="4,0,4,6"
                                        ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#1A5B8DEF"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FF5B8DEF"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Hold Alt + tap ` to cycle. Release Alt to commit, Esc to cancel."
                       Foreground="#5A5A5A"
                       FontSize="11"
                       Margin="8,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
