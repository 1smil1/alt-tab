<Window x:Class="WindowSwitcherWpf.SwitcherOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Switcher"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F7"
        SizeToContent="WidthAndHeight">
    <Border x:Name="RootBorder"
            BorderBrush="#22000000"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="2" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="WindowsList" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card"
                                Margin="6"
                                CornerRadius="8"
                                BorderBrush="#1A000000"
                                BorderThickness="1"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnCardClick">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EAF3FF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FF5B8DEF"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,7,8,7">
                                    <Image Width="20" Height="20"
                                           VerticalAlignment="Center"
                                           Source="{Binding Icon}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="#202020"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="7,0,0,0"
                                               MaxWidth="300"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border x:Name="ThumbBorder"
                                        CornerRadius="6"
                                        Background="#FFEFEFEF"
                                        BorderBrush="#22000000"
                                        BorderThickness="1"
                                        Margin="7,0,7,7"
                                        Height="150"
                                        Width="{Binding ThumbWidth}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="ThumbImage"
                                               Source="{Binding Thumbnail}"
                                               Height="150"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               Visibility="{Binding ThumbVisibility}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Image Width="44" Height="44"
                                               Source="{Binding Icon}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding PlaceholderVisibility}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</Window>
