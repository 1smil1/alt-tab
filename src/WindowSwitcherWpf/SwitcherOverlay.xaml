<Window x:Class="WindowSwitcherWpf.SwitcherOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Switcher"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        SizeToContent="WidthAndHeight">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0"
                      ResizeBorderThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="RootBorder"
            Background="#59FFFFFF"
            BorderBrush="#3AFFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True"
            MouseLeftButtonUp="OnOverlayMouseUp">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Sub view banner (子标签页面): stack title + member count +
                 gesture hints; replaces the main header while active. -->
            <StackPanel x:Name="StackHeader"
                        Grid.Row="0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Visibility="Collapsed"
                        Margin="0,0,0,10">
                <TextBlock Text="🗂"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBlock x:Name="StackTitleText"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF202020"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StackCountText"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#FF0078D4"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>
                <TextBlock Text="  → ← / Alt+` 切换 · 数字跳成员 · Esc 返回主页面 · 拖出网格外=剥离"
                           FontSize="11"
                           Foreground="#FF6A6A6A"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </StackPanel>
            <!-- Header (右上角): template picker, smart-sort picker + apply,
                 export — all data from the exe-adjacent config.json. -->
            <StackPanel x:Name="MainHeader"
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">
                <TextBlock Text="模板:"
                           FontSize="12"
                           Foreground="#FF404040"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <ComboBox x:Name="TemplateCombo"
                          Width="130"
                          FontSize="12"
                          ToolTip="应用模板：已有标签和模板一一对应变成固定"
                          SelectionChanged="OnTemplateSelected"/>
                <TextBlock Text="排序:"
                           FontSize="12"
                           Foreground="#FF404040"
                           VerticalAlignment="Center"
                           Margin="12,0,5,0"/>
                <ComboBox x:Name="SortCombo"
                          Width="130"
                          FontSize="12"
                          ToolTip="智能排序方法（来自 config.json，可重复应用）"
                          SelectionChanged="OnSortSelected"/>
                <Button x:Name="SortApplyButton"
                        Content="应用"
                        FontSize="12"
                        Padding="8,2"
                        Margin="6,0,0,0"
                        ToolTip="再次应用当前选中的智能排序"
                        Click="OnSortApply"/>
                <Button x:Name="ExportButton"
                        Content="导出"
                        FontSize="12"
                        Padding="8,2"
                        Margin="6,0,0,0"
                        ToolTip="把当前槽位布局导出为模板（存入 config.json）"
                        Click="OnExportClick"/>
            </StackPanel>
            <ScrollViewer x:Name="Scroller"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="WindowsList" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card"
                                Margin="6"
                                CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonDown="OnCardMouseDown"
                                MouseMove="OnCardMouseMove"
                                MouseLeftButtonUp="OnCardClick"
                                MouseEnter="OnCardMouseEnter"
                                MouseLeave="OnCardMouseLeave">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- BorderBrush/Thickness live here (not on
                                         the element) so the selection trigger
                                         can actually override them — local
                                         values always beat style triggers. -->
                                    <Setter Property="BorderBrush" Value="#1A000000"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EAF3FF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FF0078D4"/>
                                            <Setter Property="BorderThickness" Value="3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid x:Name="CardRoot">
                                <!-- Group accent strip: 3px hue line at the
                                     card top; brightens when any card of
                                     the same app group is hovered. -->
                                <Rectangle Height="3"
                                           VerticalAlignment="Top"
                                           Margin="14,3,14,0"
                                           RadiusX="1.5" RadiusY="1.5"
                                           Fill="{Binding GroupStripBrush}"/>
                            <StackPanel>
                                <Grid Margin="8,7,8,7">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <!-- Slot number badge sits top-left, in
                                             front of the title logo (数字放左上
                                             角，标题logo前面): 0 = most recent,
                                             1..10 managed slots, hidden if
                                             unmanaged. -->
                                        <Border Background="{Binding GroupBadgeBrush}"
                                                CornerRadius="4"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding BadgeVisibility}"
                                                ToolTip="Alt+数字 直达此标签">
                                            <TextBlock Text="{Binding SlotBadge}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#FF5A5A5A"
                                                       Margin="4,1"/>
                                        </Border>
                                        <!-- Stack member count: ×N badge right
                                             after the slot digit (堆叠共用一
                                             个数字, N = 成员数). -->
                                        <Border Background="{Binding GroupBadgeBrush}"
                                                CornerRadius="4"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding StackBadgeVisibility}"
                                                ToolTip="堆叠: Alt+数字 进子页面">
                                            <TextBlock Text="{Binding StackBadge}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#FF5A5A5A"
                                                       Margin="4,1"/>
                                        </Border>
                                        <Image Width="20" Height="20"
                                               VerticalAlignment="Center"
                                               Source="{Binding Icon}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   Foreground="#202020"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="7,0,0,0"
                                                   MaxWidth="230"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- Hover tools on the right: pin and
                                         close (hover only, opacity keeps
                                         layout stable so nothing shifts). -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Border Background="Transparent"
                                                CornerRadius="4"
                                                Margin="2,0"
                                                Width="20" Height="20"
                                                MouseLeftButtonDown="OnToolDown"
                                                MouseLeftButtonUp="OnPinClick"
                                                ToolTip="固定此槽位">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=Card, Path=IsMouseOver}" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#14000000"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="📌"
                                                       FontSize="10"
                                                       Foreground="{Binding PinBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="Transparent"
                                                CornerRadius="4"
                                                Margin="2,0"
                                                Width="20" Height="20"
                                                MouseLeftButtonDown="OnToolDown"
                                                MouseLeftButtonUp="OnCloseClick"
                                                ToolTip="关闭窗口">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=Card, Path=IsMouseOver}" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#14E81123"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="✕"
                                                       FontSize="11"
                                                       Foreground="#FF616161"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="ThumbBorder"
                                        CornerRadius="6"
                                        Background="#FFEFEFEF"
                                        BorderBrush="#22000000"
                                        BorderThickness="1"
                                        Margin="7,0,7,7"
                                        Height="150"
                                        Width="{Binding ThumbWidth}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="ThumbImage"
                                               Source="{Binding Thumbnail}"
                                               Height="150"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               Visibility="{Binding ThumbVisibility}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Image Width="44" Height="44"
                                               Source="{Binding Icon}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding PlaceholderVisibility}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
