<Application x:Class="WindowSwitcherWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="Overlay.Background" Color="#EE1E1E1E" />
            <SolidColorBrush x:Key="Overlay.Panel" Color="#F52A2A2A" />
            <SolidColorBrush x:Key="Overlay.Foreground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Overlay.Muted" Color="#FFB0B0B0" />
            <SolidColorBrush x:Key="Overlay.Accent" Color="#FF5B8DEF" />
            <SolidColorBrush x:Key="Overlay.Border" Color="#FF404040" />
            <SolidColorBrush x:Key="Overlay.GroupBackground" Color="#FF2E2E2E" />

            <Style TargetType="TextBlock" x:Key="Overlay.TitleText">
                <Setter Property="Foreground" Value="{StaticResource Overlay.Foreground}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style TargetType="TextBlock" x:Key="Overlay.SubText">
                <Setter Property="Foreground" Value="{StaticResource Overlay.Muted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
