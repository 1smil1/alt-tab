<Window x:Class="WindowSwitcherWpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 — Window Switcher"
        Width="700" Height="640"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        ShowInTaskbar="False"
        Topmost="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">

            <!-- ============ 快捷键块 ============ -->
            <TextBlock Text="快捷键" FontSize="16" FontWeight="Bold"
                       Foreground="#FFE0E0E0"/>
            <Border Background="#FF2A2A2A" CornerRadius="8"
                    Padding="14,10" Margin="0,8,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主快捷键" Foreground="#FFE0E0E0"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="HotkeyBox" Grid.Column="1"
                                 TextChanged="OnHotkeyChanged"/>
                    </Grid>
                    <TextBlock Text='格式 "Alt+`" / "Alt+Tab" / "Alt+-" / F1-F12；修饰键必须含 Alt（松开 Alt = 确认切换）'
                               FontSize="11" Foreground="#FF909090" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="一次直达修饰键" Foreground="#FFE0E0E0"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="QuickModBox" Grid.Column="1" Width="120"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="Alt"/>
                            <ComboBoxItem Content="Ctrl"/>
                            <ComboBoxItem Content="Shift"/>
                            <ComboBoxItem Content="Win"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="拦截系统 Alt+Tab" Foreground="#FFE0E0E0"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="SuppressBox" Grid.Column="1" Width="120"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="自动（热键为 Alt+Tab 时拦截）"/>
                            <ComboBoxItem Content="始终拦截"/>
                            <ComboBoxItem Content="从不拦截"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 智能排序块 ============ -->
            <TextBlock Text="智能排序" FontSize="16" FontWeight="Bold"
                       Foreground="#FFE0E0E0"/>
            <TextBlock Text='规则自上而下按优先级生效；类型：process=进程名 / title=标题包含 / path=路径 / group=精确 GroupKey'
                       FontSize="11" Foreground="#FF909090" Margin="0,2,0,6"
                       TextWrapping="Wrap"/>
            <Border Background="#FF2A2A2A" CornerRadius="8"
                    Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <ListBox x:Name="SortMethodList" MinHeight="150"
                                 DisplayMemberPath="Name"
                                 Background="#FF222222" Foreground="#FFE0E0E0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="添加方法" Click="OnAddSortMethod"
                                    Padding="10,3"/>
                            <Button Content="删除选中" Click="OnDeleteSortMethod"
                                    Padding="10,3" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid x:Name="SortEditArea" Grid.Column="1" Margin="14,0,0,0"
                          DataContext="{Binding SelectedItem, ElementName=SortMethodList}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="名称" Foreground="#FFE0E0E0"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rules}" Grid.Row="1"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <ComboBox Width="92" SelectedValue="{Binding Type}"
                                                  SelectedValuePath="Content">
                                            <ComboBoxItem Content="process"/>
                                            <ComboBoxItem Content="title"/>
                                            <ComboBoxItem Content="path"/>
                                            <ComboBoxItem Content="group"/>
                                        </ComboBox>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="220" Margin="6,0,0,0"/>
                                        <Button Content="✕" Click="OnDeleteRule"
                                                Padding="6,1" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="添加规则" Grid.Row="2" Click="OnAddRule"
                                Padding="10,3" HorizontalAlignment="Left"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ 模板块 ============ -->
            <TextBlock Text="模板" FontSize="16" FontWeight="Bold"
                       Foreground="#FFE0E0E0"/>
            <TextBlock Text='模板由 overlay 顶栏"导出"生成 — 此处可改名/删除'
                       FontSize="11" Foreground="#FF909090" Margin="0,2,0,6"
                       TextWrapping="Wrap"/>
            <Border Background="#FF2A2A2A" CornerRadius="8"
                    Padding="14,10" Margin="0,0,0,16">
                <StackPanel>
                    <ListBox x:Name="TemplateList" MinHeight="90"
                             DisplayMemberPath="Name"
                             Background="#FF222222" Foreground="#FFE0E0E0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="TemplateNameBox" Width="200"/>
                        <Button Content="重命名" Click="OnRenameTemplate"
                                Padding="10,3" Margin="8,0,0,0"/>
                        <Button Content="删除选中" Click="OnDeleteTemplate"
                                Padding="10,3" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 底部按钮 ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="#FF909090" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="保存" Click="OnSave"
                            Padding="18,4" FontWeight="Bold"/>
                    <Button Content="取消" Click="OnCancel"
                            Padding="18,4" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
