<Window x:Class="WindowSwitcherWpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 — Window Switcher"
        Width="700" Height="640"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        ShowInTaskbar="False"
        Topmost="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">

            <!-- ============ 快捷键块 ============ -->
            <TextBlock Text="快捷键" FontSize="16" FontWeight="Bold"
                       Foreground="#FFE0E0E0"/>
            <Border Background="#FF2A2A2A" CornerRadius="8"
                    Padding="14,10" Margin="0,8,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主快捷键" Foreground="#FFE0E0E0"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="HotkeyBox" Grid.Column="1"
                                 TextChanged="OnHotkeyChanged"/>
                    </Grid>
                    <TextBlock Text='格式 "Alt+`" / "Alt+Tab" / "Alt+-" / F1-F12；修饰键必须含 Alt（松开 Alt = 确认切换）'
                               FontSize="11" Foreground="#FF909090" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="第二快捷键" Foreground="#FFE0E0E0"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SecondHotkeyBox" Grid.Column="1"
                                 TextChanged="OnSecondHotkeyChanged"/>
                    </Grid>
                    <TextBlock Text='同上格式。一按就开面板, 持续存在, Esc 才关 (松开 Alt 不提交). 空 = 禁用.'
                               FontSize="11" Foreground="#FF909090" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="一次直达修饰键" Foreground="#FFE0E0E0"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="QuickModBox" Grid.Column="1" Width="120"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="Alt"/>
                            <ComboBoxItem Content="Ctrl"/>
                            <ComboBoxItem Content="Shift"/>
                            <ComboBoxItem Content="Win"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="拦截系统 Alt+Tab" Foreground="#FFE0E0E0"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="SuppressBox" Grid.Column="1" Width="120"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="自动（热键为 Alt+Tab 时拦截）"/>
                            <ComboBoxItem Content="始终拦截"/>
                            <ComboBoxItem Content="从不拦截"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="AutoStartBox" Content="开机自启动"
                              Foreground="#FFE0E0E0" Margin="0,12,0,0"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="登录后自动启动 (写 HKCU\...\Run, 不需管理员)"
                               FontSize="11" Foreground="#FF909090" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ============ 选中即缩小化 ============ -->
            <TextBlock Text="选中同一个窗口时缩小化" FontSize="16" FontWeight="Bold"
                       Foreground="#FFE0E0E0"/>
            <Border Background="#FF2A2A2A" CornerRadius="8"
                    Padding="14,10" Margin="0,8,0,16">
                <StackPanel>
                    <CheckBox x:Name="GlowBox" Margin="0,0,0,10"
                              Foreground="#FFE0E0E0"
                              Content="切到窗口时，该窗口边框闪一圈蓝光"/>
                    <TextBlock Text="面板内提交（方向键 / Alt+Tab 循环后松开 Alt）"
                               Foreground="#FFE0E0E0"/>
                    <CheckBox x:Name="CommitMinBox" Margin="0,6,0,0"
                              Foreground="#FFE0E0E0"
                              Content="选中的就是当前前台 → 缩小化"/>
                    <CheckBox x:Name="CommitMinPinnedBox" Margin="0,6,0,0"
                              Foreground="#FFE0E0E0"
                              Content="固定标签同上（不勾 = 固定标签只激活）"/>
                    <TextBlock Text='Alt+Tab / 方向键选中已在呈现的窗口，松开 Alt 时缩小化。'
                               FontSize="11" Foreground="#FF909090" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="一次直达（Alt+数字，面板关闭时）"
                               Foreground="#FFE0E0E0" Margin="0,14,0,0"/>
                    <CheckBox x:Name="QuickMinBox" Margin="0,6,0,0"
                              Foreground="#FFE0E0E0"
                              Content="选中的就是当前前台 → 缩小化"/>
                    <CheckBox x:Name="QuickMinPinnedBox" Margin="0,6,0,0"
                              Foreground="#FFE0E0E0"
                              Content="固定标签同上（不勾 = 固定标签只激活）"/>
                    <TextBlock Text='直达再按一次当前前台窗口 = 收起。'
                               FontSize="11" Foreground="#FF909090" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ============ 底部按钮 ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="#FF909090" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="保存" Click="OnSave"
                            Padding="18,4" FontWeight="Bold"/>
                    <Button Content="取消" Click="OnCancel"
                            Padding="18,4" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
